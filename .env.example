# Cathena Convex — copy to .env and fill in. Never commit .env.

# Public domain for https (docker-compose + Caddy). Point its DNS A record at the server.
DOMAIN=

# mainnet | testnet
HL_NETWORK=mainnet

# The owner's wallet (you). Always allowed to sign in, gets MAX_STAKE_USDC and no deposit cap.
HL_ACCOUNT_ADDRESS=

# No longer used: each user signs in with their wallet and the app creates and stores their agent key.
HL_AGENT_PRIVATE_KEY=

# Extra wallets that may sign in (comma-separated). Empty = only the owner (HL_ACCOUNT_ADDRESS) and invite links.
# * = open beta: any wallet, up to MAX_USERS.
ALLOWED_ADDRESSES=
MAX_USERS=10
# Invite links: any wallet opening the app with ?invite=<code> may join, up to <uses> per code (separate from MAX_USERS).
# Optional last day (UTC): after it the link stops creating accounts and those accounts can't open new trades
# (they can still cash out and withdraw). Pick hard-to-guess codes if the link is public.
# e.g. INVITE_CODES=colosseum-k7q2:25:2026-11-30
INVITE_CODES=
# Limits for everyone except the owner.
USER_MAX_STAKE_USDC=20
# What Cathena will ever have at risk for a user at once (sum of max losses of open trades), whatever they deposit.
USER_MAX_OPEN_RISK_USDC=20
MAX_DEPOSIT_USDC=20

# Encrypts each user's agent key at rest, and signs session cookies. If unset, random secrets are created once in
# DATA_DIR (.agent_key_secret, .session_secret, mode 600). Back them up: lose AGENT_KEY_SECRET and users must re-approve.
AGENT_KEY_SECRET=
SESSION_SECRET=
# Set to 1 when served over https.
COOKIE_SECURE=

# false = dry run: orders are simulated against the live order book and nothing is sent.
LIVE_TRADING=false

# Hard cap per trade (USDC). Start small.
MAX_STAKE_USDC=100

# Starting balance shown in dry-run mode when no account address is set.
DRY_RUN_BALANCE=1000

# Early cash-out fee (Cathena's revenue). Charged on the closing orders only.
# Hyperliquid caps builder fees at 100 bps on spot/outcomes and 10 bps on perps.
CASHOUT_FEE_BINARY_BPS=50
CASHOUT_FEE_PERP_BPS=5
# Builder wallet that collects the fee on-chain. Each user approves it once during Set up, up to BUILDER_MAX_FEE_RATE.
# The fee is only attached to an order once Hyperliquid confirms that user's approval covers it. Hyperliquid requires
# the builder account to hold at least 100 USDC in perps. A user who *is* the builder pays no fee.
BUILDER_ADDRESS=
BUILDER_MAX_FEE_RATE=0.5%
